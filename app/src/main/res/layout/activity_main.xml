<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.MainActivity">

    <TextView
        android:id="@+id/lblTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculadora CFE"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/txtLectAnterior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Lectura Anterior"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/lblTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/txtLectActual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Lectura Actual"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/txtLectAnterior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp" />

    <EditText
        android:id="@+id/txtCostoKw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Costo del KW"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/txtLectActual"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnCalcularKw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Calcular KW"
        app:layout_constraintTop_toBottomOf="@id/txtCostoKw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/txtKwConsumidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Salida: KW"
        android:background="#E0E0E0"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnCalcularKw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnCalcularRecibo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Calcular Recibo"
        app:layout_constraintTop_toBottomOf="@id/txtKwConsumidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="14dp" />

    <Button
        android:id="@+id/btnPasarDatos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="176dp"
        android:layout_marginEnd="24dp"
        android:text="Pasar Datos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtKwConsumidos" />

    <TextView
        android:id="@+id/txtRecibo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Salida: El pago del recibo"
        android:background="#E0E0E0"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnCalcularRecibo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp" />

    <Button
        android:id="@+id/btnPasarDatos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="444dp"
        android:layout_marginEnd="16dp"
        android:text="Pasar Datos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtRecibo" />

</androidx.constraintlayout.widget.ConstraintLayout>